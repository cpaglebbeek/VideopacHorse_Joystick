<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/vph_accent_pressed" />
            <stroke
                android:width="4dp"
                android:color="@color/vph_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/vph_surface" />
            <stroke
                android:width="4dp"
                android:color="@color/vph_accent" />
        </shape>
    </item>
</selector>
